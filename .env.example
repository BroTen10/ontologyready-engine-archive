# OntologyReady 环境变量

# API Key — 所有 API 请求需携带此 Key
# 首次启动未配置时，系统自动生成 UUID 并输出到日志
API_KEY=changeme

# 数据库连接（Docker Compose 环境）
DATABASE_URL=postgresql://ontologyready:ontologyready@postgres:5432/ontologyready

# 数据库连接（本地开发环境）
# DATABASE_URL=postgresql://ontologyready:ontologyready@localhost:5432/ontologyready
