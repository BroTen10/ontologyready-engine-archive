# Auto detect text files and normalize to LF on commit
* text=auto

# TypeScript
*.ts text
*.tsx text

# Web
*.html text
*.css text
*.js text
*.jsx text
*.json text

# Config
*.yml text
*.yaml text
*.toml text
*.config.* text

# Shell scripts - keep LF
*.sh text eol=lf
*.ps1 text eol=crlf

# SQL
*.sql text

# Docs
*.md text
*.txt text

# Images - binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Environment (keep as-is)
.env text eol=crlf
