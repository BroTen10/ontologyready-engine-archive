{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "primary": {
      "50": { "$value": "#0F2347", "$description": "浅色背景/徽章 (Dark)" },
      "100": { "$value": "#1A3564", "$description": "悬浮态背景 (Dark)" },
      "500": { "$value": "#4C8DFF", "$description": "主品牌色 - 科技蓝 (Dark)" },
      "600": { "$value": "#6AA3FF", "$description": "悬浮态" },
      "700": { "$value": "#85B8FF", "$description": "按下态" }
    },
    "secondary": {
      "50": { "$value": "#3A1A12", "$description": "浅色背景 (Dark)" },
      "500": { "$value": "#FF8A5C", "$description": "主CTA色 - 活力橙 (Dark)" },
      "600": { "$value": "#FFA57D", "$description": "悬浮态" }
    },
    "neutral": {
      "0": { "$value": "#000000", "$description": "OLED纯黑" },
      "50": { "$value": "#0A0A0A", "$description": "主背景" },
      "100": { "$value": "#141414", "$description": "卡片表面" },
      "200": { "$value": "#1E1E1E", "$description": "悬浮态" },
      "300": { "$value": "#2A2A2A", "$description": "边框" },
      "400": { "$value": "#71717A", "$description": "禁用文本" },
      "500": { "$value": "#A1A1AA", "$description": "次要文本" },
      "600": { "$value": "#E4E4E7", "$description": "主要文本" }
    },
    "background": {
