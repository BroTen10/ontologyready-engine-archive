      "elevated": { "$value": "#1E1E1E" },
      "overlay": { "$value": "rgba(0,0,0,0.6)" }
    },
    "semantic": {
      "success": { "$value": "#10B981" },
      "warning": { "$value": "#F59E0B" },
      "error": { "$value": "#EF4444" },
      "info": { "$value": "#60A5FA" }
    }
  },
  "typography": {
    "fontFamily": {
      "primary": { "$value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" },
      "mono": { "$value": "'JetBrains Mono', 'Fira Code', 'Consolas', monospace" }
    },
    "fontSize": {
      "hero": { "$value": "48px" },
      "h1": { "$value": "32px" },
      "h2": { "$value": "24px" },
      "h3": { "$value": "20px" },
      "bodyLg": { "$value": "18px" },
      "body": { "$value": "16px" },
      "small": { "$value": "14px" },
      "caption": { "$value": "12px" }
    },
    "fontWeight": {
      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold": { "$value": "700" }
    },
    "lineHeight": {
      "tight": { "$value": "1.1" },
      "snug": { "$value": "1.3" },
      "normal": { "$value": "1.5" },
      "relaxed": { "$value": "1.6" }
    }
  },
  "spacing": {
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "24px" },
    "xl": { "$value": "32px" },
    "2xl": { "$value": "48px" },
    "3xl": { "$value": "64px" },
    "4xl": { "$value": "96px" }
  },
  "borderRadius": {
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "xl": { "$value": "16px" },
    "full": { "$value": "9999px" }
  },
  "boxShadow": {
    "card": { "$value": "0 0 0 1px rgba(255,255,255,0.05), 0 4px 12px rgba(0,0,0,0.5)" },
    "cardHover": { "$value": "0 0 0 1px rgba(255,255,255,0.1), 0 8px 24px rgba(0,0,0,0.6)" },
    "glowPrimary": { "$value": "0 0 20px rgba(76,141,255,0.4), 0 0 40px rgba(76,141,255,0.2)" },
    "glowSecondary": { "$value": "0 0 20px rgba(255,138,92,0.4), 0 0 40px rgba(255,138,92,0.2)" },
    "modal": { "$value": "0 0 0 1px rgba(255,255,255,0.1), 0 24px 48px rgba(0,0,0,0.7)" }
  },
  "animation": {
    "duration": {
      "fast": { "$value": "150ms" },
      "normal": { "$value": "250ms" },
      "slow": { "$value": "400ms" }
    },
    "easing": {
      "default": { "$value": "ease-out" },
      "smooth": { "$value": "ease-in-out" }
    }
  },
  "breakpoint": {
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  }
}
